# Python 缓存和构建文件
__pycache__/
*.py[cod]
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 虚拟环境
.venv/
venv/
env/

# IDE 和操作系统文件
.idea/
.vscode/
.DS_Store
Thumbs.db

# AI 助手工作区（本地记忆与技能，不进入版本库）
.workbuddy/

# 密钥和本地配置
.env
.env.*
!.env.example
*.pem
*.key

# 原始、中间和处理后数据集
data/raw/*.csv
data/raw/*.zip
data/interim/*
!data/interim/README.md
data/processed/*
!data/processed/README.md

# 模型产物和训练输出
models/*
!models/README.md
*.pt
*.pth
*.bin
*.pkl
*.joblib
checkpoints/
runs/
wandb/

# 生成的报告
reports/figures/*
!reports/figures/README.md
reports/final-presentation/*.pptx
reports/final-presentation/*.pdf

# Notebook 检查点
.ipynb_checkpoints/

# Office 打开文件时产生的锁文件（崩溃后会残留，不应入库）
~$*

# 本地工具与运行期产物
.codex-ppt-build/
.codex-resume-work/
.codex-worktrees/
.web-server.log
.web-server.pid

# 个人材料（简历等），严禁提交到团队仓库。
# 该目录名有误导性：它不是项目交付物，内容为个人隐私信息，见 AGENTS.md §8.2。
deliverables/
